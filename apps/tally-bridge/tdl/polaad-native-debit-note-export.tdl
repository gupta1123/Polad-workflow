;; Polaad native Debit Note exporter for TallyPrime.
;;
;; This add-on is invoked by the Polaad connector, never by a user navigating
;; Tally screens. The connector supplies the voucher MasterID and a PDF path.
;; The print report is bound to that MasterID, so the currently visible Tally
;; screen cannot change which document is exported.

[Variable : PolaadVoucherMasterID]
Type : String

[Variable : PolaadDebitNotePdfPath]
Type : String

[Report : Polaad Native Debit Note Print]
Form   : VCH Display
Object : Voucher : "ID:" + ##PolaadVoucherMasterID

[Report : Polaad Native Debit Note Export Trigger]
Form     : Polaad Native Debit Note Export Trigger
Variable : PolaadVoucherMasterID, PolaadDebitNotePdfPath
;; Report events require an explicit condition between the event and action.
;; `Yes` makes this non-interactive trigger run as soon as Tally loads it.
On : Load : Yes : Call : Polaad Export Native Debit Note PDF

;; Tally's HTTP report runner still instantiates a form, even though the
;; report only performs a background export.  Keep that form deliberately
;; empty: it is never shown because the export action suppresses UI.
[Form : Polaad Native Debit Note Export Trigger]
Part : Polaad Native Debit Note Export Trigger

[Part : Polaad Native Debit Note Export Trigger]
Line : Polaad Native Debit Note Export Trigger

[Line : Polaad Native Debit Note Export Trigger]
Field : Polaad Native Debit Note Export Trigger

[Field : Polaad Native Debit Note Export Trigger]
Set As : ""

[Function : Polaad Export Native Debit Note PDF]
00 : SET : SVPrintFileName : ##PolaadDebitNotePdfPath
10 : SET : SVExportFormat : $$SysName:PDF
20 : SET : SVOutputType : "Export Button"
30 : EXPORT REPORT : Polaad Native Debit Note Print : Yes
